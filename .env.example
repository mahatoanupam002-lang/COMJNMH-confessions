# ── Supabase ───────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...   # "service_role" key (never expose to browser)

# ── Instagram Graph API ─────────────────────────────────────────────────────────
# See SETUP.md for step-by-step instructions to get these values
IG_USER_ID=17841400000000000       # Instagram Business/Creator numeric user ID
IG_ACCESS_TOKEN=EAAxxxxxxxx        # Long-lived Page access token (never expires)

# ── Vercel Cron protection ─────────────────────────────────────────────────────
# Any random string — Vercel sends this as Authorization: Bearer <secret>
CRON_SECRET=replace_with_random_string

# ── Public URL ─────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash), used to build Instagram image URLs
NEXT_PUBLIC_BASE_URL=https://comjnmh.vercel.app

# ── Posting behavior ───────────────────────────────────────────────────────────
# Minimum votes an idea must have before it gets posted to Instagram (default: 1)
MIN_VOTES_TO_POST=1
# How many ideas to post per cron run (default: 3)
MAX_POSTS_PER_RUN=3
